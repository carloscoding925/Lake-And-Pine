{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lakeandpine",
  "main": "worker.js",
  "compatibility_date": "2026-04-29",
  "observability": {
    "enabled": true
  },
  // Everything served publicly lives in ./public. The Worker sits outside it on
  // purpose, so worker.js is never itself servable. ASSETS is how the Worker hands
  // back static files for any request it doesn't handle.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
